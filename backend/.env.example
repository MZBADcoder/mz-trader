APP_ENV=dev
APP_SECRET_KEY=replace-with-strong-random-secret

MASSIVE_API_KEY=
MASSIVE_STOCK_PLAN=developer

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trader_refactor
REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO
LOG_DIR=var/log
LOG_FILE_NAME=application.log
LOG_BACKUP_COUNT=14
LOG_TO_STDOUT=true
REQUEST_ID_HEADER=X-Request-ID
