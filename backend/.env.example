APP_ENV=dev
APP_SECRET_KEY=replace-with-strong-random-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=86400
AUTH_JWT_ALGORITHM=HS256
PASSWORD_HASH_ITERATIONS=600000
PASSWORD_HASH_SALT_BYTES=16

MASSIVE_API_KEY=
MASSIVE_STOCK_PLAN=developer
MASSIVE_BASE_URL=https://api.massive.com
MASSIVE_TIMEOUT_SECONDS=10.0

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trader_refactor
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=

MARKET_DATA_SNAPSHOT_TERMINAL_FINALIZER_HOUR_ET=20
MARKET_DATA_SNAPSHOT_TERMINAL_FINALIZER_MINUTE_ET=30
MARKET_DATA_SNAPSHOT_REFRESH_LOCK_TTL_SECONDS=300

MARKET_DATA_BARS_POST_CLOSE_FINALIZER_HOUR_ET=17
MARKET_DATA_BARS_POST_CLOSE_FINALIZER_MINUTE_ET=0
MARKET_DATA_BARS_GAP_RECONCILE_MAX_PROVIDER_CALLS_PER_TICKER=8
MARKET_DATA_BARS_GAP_RECONCILE_HOUR_ET=2
MARKET_DATA_BARS_GAP_RECONCILE_MINUTE_ET=0
MARKET_DATA_BARS_RETENTION_CLEANUP_HOUR_ET=3
MARKET_DATA_BARS_RETENTION_CLEANUP_MINUTE_ET=0

LOG_LEVEL=INFO
LOG_DIR=var/log
LOG_FILE_NAME=application.log
CELERY_WORKER_LOG_FILE_NAME=celery-worker.log
CELERY_BEAT_LOG_FILE_NAME=celery-beat.log
CELERY_LOG_FILE_NAME=celery.log
LOG_BACKUP_COUNT=14
LOG_TO_STDOUT=true
REQUEST_ID_HEADER=X-Request-ID
